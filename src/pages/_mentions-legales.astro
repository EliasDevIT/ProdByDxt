---
import BaseLayout from '../layouts/BaseLayout.astro';
import Label from '../components/Label.astro';
import { legal, isTodo } from '../data/legal';
import { site } from '../data/site';

/** Bloc "définition" : met en évidence les champs encore à compléter. */
const rows: { term: string; value: string }[] = [
  { term: 'Éditeur du site', value: legal.editorName },
  { term: 'Statut juridique', value: legal.status },
  { term: 'Adresse', value: legal.address },
  { term: 'SIRET', value: legal.siret },
  { term: 'Code APE / NAF', value: legal.apeCode },
  { term: 'TVA', value: legal.vat },
  { term: 'Directeur de la publication', value: legal.publicationDirector },
  { term: 'Contact', value: site.contact.email },
];

const hostRows: { term: string; value: string }[] = [
  { term: 'Hébergeur', value: legal.host.name },
  { term: 'Adresse', value: legal.host.address },
  { term: 'Site', value: legal.host.url },
];

const remaining = [...rows, ...hostRows, { term: '', value: legal.updatedAt }].filter((r) =>
  isTodo(r.value)
).length;
---

<BaseLayout
  title={site.seo.titleTemplate.replace('%s', 'Mentions légales')}
  description="Mentions légales du site Prod by Dxt : éditeur, hébergeur, propriété intellectuelle et données personnelles."
>
  <article class="mx-auto w-full max-w-3xl px-6 py-20 sm:px-8 md:py-28">
    <Label>Informations légales</Label>
    <h1 class="mt-7 font-light text-hero text-bone">Mentions légales<span class="text-gold">.</span></h1>

    {
      remaining > 0 && (
        <aside class="mt-10 border border-gold-deep bg-ink-raised p-6">
          <p class="font-mono text-[0.65rem] font-medium uppercase tracking-label text-gold">
            {remaining} champ{remaining > 1 ? 's' : ''} à compléter
          </p>
          <p class="mt-3 text-sm leading-relaxed text-ash">
            Renseigne les valeurs dans <code class="font-mono text-bone">src/data/legal.ts</code>.
            Cet encadré disparaît automatiquement une fois tout rempli.
          </p>
        </aside>
      )
    }

    <section class="mt-16">
      <h2 class="font-mono text-[0.68rem] font-medium uppercase tracking-label text-gold">
        1. Éditeur
      </h2>
      <dl class="mt-7 divide-y divide-line border-y border-line">
        {
          rows.map((row) => (
            <div class="grid grid-cols-1 gap-1 py-4 sm:grid-cols-[14rem_1fr] sm:gap-6">
              <dt class="text-sm text-ash">{row.term}</dt>
              <dd
                class:list={[
                  'text-sm',
                  isTodo(row.value) ? 'font-mono text-gold' : 'text-bone',
                ]}
              >
                {row.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mt-14">
      <h2 class="font-mono text-[0.68rem] font-medium uppercase tracking-label text-gold">
        2. Hébergement
      </h2>
      <dl class="mt-7 divide-y divide-line border-y border-line">
        {
          hostRows.map((row) => (
            <div class="grid grid-cols-1 gap-1 py-4 sm:grid-cols-[14rem_1fr] sm:gap-6">
              <dt class="text-sm text-ash">{row.term}</dt>
              <dd
                class:list={[
                  'text-sm break-words',
                  isTodo(row.value) ? 'font-mono text-gold' : 'text-bone',
                ]}
              >
                {row.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mt-14">
      <h2 class="font-mono text-[0.68rem] font-medium uppercase tracking-label text-gold">
        3. Propriété intellectuelle
      </h2>
      <p class="mt-6 text-sm leading-relaxed text-ash">
        L'ensemble du contenu de ce site (structure, textes, identité visuelle, code) est la
        propriété de l'éditeur, sauf mention contraire. Toute reproduction ou représentation,
        totale ou partielle, sans autorisation écrite préalable est interdite. Les noms, logos et
        visuels des projets présentés restent la propriété de leurs titulaires respectifs.
      </p>
    </section>

    <section class="mt-14">
      <h2 class="font-mono text-[0.68rem] font-medium uppercase tracking-label text-gold">
        4. Données personnelles
      </h2>
      <p class="mt-6 text-sm leading-relaxed text-ash">
        Les données saisies dans le formulaire de contact (nom, email, projet, message) servent
        uniquement à répondre à ta demande. Elles ne sont ni revendues, ni utilisées à des fins
        publicitaires. Le formulaire est traité par le service Formspark, qui achemine les messages
        vers l'adresse <a
          href={`mailto:${site.contact.email}`}
          class="link-underline text-bone">{site.contact.email}</a
        >.
      </p>
      <p class="mt-5 text-sm leading-relaxed text-ash">
        Conformément au RGPD, tu disposes d'un droit d'accès, de rectification et de suppression de
        tes données : il suffit d'en faire la demande par mail à la même adresse.
      </p>
    </section>

    <section class="mt-14">
      <h2 class="font-mono text-[0.68rem] font-medium uppercase tracking-label text-gold">
        5. Cookies
      </h2>
      <p class="mt-6 text-sm leading-relaxed text-ash">
        Ce site ne dépose aucun cookie et n'utilise aucun traceur publicitaire ni outil de mesure
        d'audience. Aucune bannière de consentement n'est donc nécessaire.
      </p>
    </section>

    <p class="mt-16 border-t border-line pt-7 font-mono text-xs text-ash">
      Dernière mise à jour : <span class:list={[isTodo(legal.updatedAt) && 'text-gold']}
        >{legal.updatedAt}</span
      >
    </p>
  </article>
</BaseLayout>
