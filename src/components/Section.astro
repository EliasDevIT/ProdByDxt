---
import Label from './Label.astro';

interface Props {
  id: string;
  label: string;
  title: string;
  intro?: string;
  class?: string;
  /** Masquer le filet de séparation du haut */
  flush?: boolean;
}

const { id, label, title, intro, class: className, flush = false } = Astro.props;
---

<section
  id={id}
  aria-labelledby={`${id}-titre`}
  class:list={[!flush && 'border-t border-line', className]}
>
  <div class="mx-auto w-full max-w-6xl px-6 py-20 sm:px-8 md:py-28 lg:py-36">
    <header class="reveal max-w-2xl">
      <Label>{label}</Label>
      <h2
        id={`${id}-titre`}
        class="mt-6 font-extrabold text-section text-bone"
      >
        {title}
      </h2>
      {intro && <p class="mt-6 max-w-xl text-base leading-relaxed text-ash sm:text-lg">{intro}</p>}
    </header>

    <div class="mt-14 md:mt-20">
      <slot />
    </div>
  </div>
</section>
