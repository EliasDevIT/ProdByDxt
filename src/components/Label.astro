---
/** Petit label mono en capitales espacées, précédé d'un trait doré. */
interface Props {
  class?: string;
  /** Masquer le trait doré */
  bare?: boolean;
}

const { class: className, bare = false } = Astro.props;
---

<p
  class:list={[
    'flex items-center gap-3 font-mono text-[0.68rem] font-medium uppercase tracking-label text-gold',
    className,
  ]}
>
  {!bare && <span aria-hidden="true" class="h-px w-7 shrink-0 bg-gold-deep"></span>}
  <span><slot /></span>
</p>
