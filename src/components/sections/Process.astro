---
import Section from '../Section.astro';
import { processSteps } from '../../data/process';
---

<Section
  id="process"
  label="Process"
  title="Comment ça se passe."
  intro="Quatre étapes, pas une de plus. Tu sais toujours où on en est."
>
  <ol class="reveal grid grid-cols-1 gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4 lg:gap-x-8">
    {
      processSteps.map((item) => (
        <li class="relative border-t border-line pt-7">
          <span
            aria-hidden="true"
            class="absolute top-0 left-0 h-px w-10 bg-gold"
          />
          <p class="font-mono text-xs font-medium tracking-label text-gold">{item.step}</p>
          <h3 class="mt-5 text-lg font-medium tracking-tight text-bone">{item.title}</h3>
          <p class="mt-3.5 text-sm leading-relaxed text-ash">{item.description}</p>
        </li>
      ))
    }
  </ol>
</Section>
