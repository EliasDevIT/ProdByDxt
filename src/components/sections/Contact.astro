---
import Section from '../Section.astro';
import Icon from '../Icon.astro';
import { site } from '../../data/site';
import { contactCopy, fields, needOptions } from '../../data/contact';

/**
 * Formspark si la variable d'env est renseignée, sinon repli automatique sur
 * un envoi mailto (le formulaire reste fonctionnel sans aucun backend).
 * Endpoint attendu : https://submit-form.com/<id-du-formulaire>
 */
const endpoint = (import.meta.env.PUBLIC_FORMSPARK_ENDPOINT ?? '').trim();
const usesFormspark = endpoint.length > 0;

const action = usesFormspark ? endpoint : `mailto:${site.contact.email}`;

/**
 * Formspark exige une URL absolue pour `_redirect`. En dev on vise le serveur
 * local, sinon tester le formulaire renverrait vers le domaine de production —
 * qui n'est pas forcément en ligne. Au build, c'est toujours le vrai domaine.
 */
const redirectBase = import.meta.env.DEV ? Astro.url.origin : Astro.site;
const redirectUrl = new URL('/?envoye=1#contact', redirectBase).href;

const inputClass =
  'w-full border-b border-line-strong bg-transparent py-3 text-base text-bone transition-colors placeholder:text-ash hover:border-ash focus:border-gold focus:outline-none';
const labelClass =
  'block font-mono text-[0.65rem] font-medium uppercase tracking-label-tight text-ash';
---

<Section id="contact" label={contactCopy.label} title={contactCopy.title} intro={contactCopy.intro}>
  <div class="grid grid-cols-1 gap-16 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] lg:gap-20">
    <div class="reveal">
      {/* Confirmation après retour de Formspark (?envoye=1) */}
      <div
        id="confirmation"
        hidden
        role="status"
        class="mb-10 border border-gold-deep bg-ink-raised p-6"
      >
        <p class="font-mono text-[0.68rem] font-medium uppercase tracking-label text-gold">
          {contactCopy.successTitle}
        </p>
        <p class="mt-3 text-sm text-ash">{contactCopy.successBody}</p>
      </div>

      <form
        action={action}
        method="post"
        {...usesFormspark ? {} : { enctype: 'text/plain' }}
        class="grid grid-cols-1 gap-9 sm:grid-cols-2"
      >
        {
          usesFormspark && (
            <>
              <input
                type="hidden"
                name="_email.subject"
                value="Nouveau message depuis prodbydxt.com"
              />
              <input type="hidden" name="_redirect" value={redirectUrl} />
              {/*
                Sans ça, Formspark recopie tout le contenu du formulaire dans
                l'URL de retour : nom, email et message se retrouveraient en
                clair dans la barre d'adresse et dans l'historique.
              */}
              <input type="hidden" name="_append" value="false" />
            </>
          )
        }

        {/* Piège à robots : invisible et hors du flux de tabulation */}
        <p class="hidden" aria-hidden="true">
          <label>
            Ne remplis pas ce champ
            <input type="checkbox" name="_honeypot" tabindex="-1" autocomplete="off" />
          </label>
        </p>

        <div>
          <label for="nom" class={labelClass}>
            {fields.name.label} <span class="text-gold" aria-hidden="true">*</span>
          </label>
          <input
            id="nom"
            name="nom"
            type="text"
            required
            autocomplete="name"
            placeholder={fields.name.placeholder}
            class:list={['mt-3', inputClass]}
          />
        </div>

        <div>
          <label for="email" class={labelClass}>
            {fields.email.label} <span class="text-gold" aria-hidden="true">*</span>
          </label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder={fields.email.placeholder}
            class:list={['mt-3', inputClass]}
          />
        </div>

        <div>
          <label for="projet" class={labelClass}>{fields.project.label}</label>
          <input
            id="projet"
            name="projet"
            type="text"
            autocomplete="organization"
            placeholder={fields.project.placeholder}
            class:list={['mt-3', inputClass]}
          />
        </div>

        <div>
          <label for="besoin" class={labelClass}>
            {fields.need.label} <span class="text-gold" aria-hidden="true">*</span>
          </label>
          <select id="besoin" name="besoin" required class:list={['mt-3', inputClass]}>
            <option value="" disabled selected>{fields.need.placeholder}</option>
            {needOptions.map((option) => <option value={option.label}>{option.label}</option>)}
          </select>
        </div>

        <div class="sm:col-span-2">
          <label for="message" class={labelClass}>
            {fields.message.label} <span class="text-gold" aria-hidden="true">*</span>
          </label>
          <textarea
            id="message"
            name="message"
            required
            rows="5"
            placeholder={fields.message.placeholder}
            class:list={['mt-3 resize-y', inputClass]}></textarea>
        </div>

        <div class="flex flex-col gap-5 sm:col-span-2 sm:flex-row sm:items-center sm:gap-8">
          <button
            type="submit"
            class="group inline-flex items-center justify-center gap-3 bg-gold px-7 py-4 font-mono text-[0.72rem] font-medium uppercase tracking-label-tight text-ink transition-colors hover:bg-gold-soft focus-visible:bg-gold-soft"
          >
            {contactCopy.submit}
            <Icon
              name="arrow"
              class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-1"
              strokeWidth={1.75}
            />
          </button>
          <p class="text-xs leading-relaxed text-ash">
            {contactCopy.note}
            {
              !usesFormspark && (
                <>
                  <br />
                  Ce formulaire ouvre ton application mail.
                </>
              )
            }
          </p>
        </div>
      </form>
    </div>

    <aside class="reveal lg:border-l lg:border-line lg:pl-12">
      <p class="font-mono text-[0.65rem] font-medium uppercase tracking-label text-ash">
        {contactCopy.directLabel}
      </p>

      <ul class="mt-8 flex flex-col gap-7">
        <li>
          <a
            href={`mailto:${site.contact.email}`}
            class="group flex items-start gap-4 text-bone transition-colors hover:text-gold"
          >
            <Icon name="mail" class="mt-1 h-5 w-5 shrink-0 text-gold" />
            <span>
              <span class="block text-base break-all">{site.contact.email}</span>
              <span class="mt-1 block text-xs text-ash">Mail direct</span>
            </span>
          </a>
        </li>
        <li>
          <a
            href={site.contact.instagramUrl}
            target="_blank"
            rel="me noopener"
            class="group flex items-start gap-4 text-bone transition-colors hover:text-gold"
          >
            <Icon name="instagram" class="mt-1 h-5 w-5 shrink-0 text-gold" />
            <span>
              <span class="block text-base">{site.contact.instagramHandle}</span>
              <span class="mt-1 block text-xs text-ash">Instagram — DM ouverts</span>
            </span>
          </a>
        </li>
      </ul>
    </aside>
  </div>
</Section>

<script>
  // Affiche la confirmation au retour de Formspark (?envoye=1).
  if (new URLSearchParams(window.location.search).has('envoye')) {
    document.getElementById('confirmation')?.removeAttribute('hidden');
  }
</script>
