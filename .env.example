# ---------------------------------------------------------------------------
# Copie ce fichier en `.env` (local) ou renseigne ces variables chez ton hébergeur.
# ---------------------------------------------------------------------------

# Endpoint Formspree. Crée un formulaire sur https://formspree.io puis colle
# l'URL complète ici. Si la variable est absente ou vide, le formulaire du site
# bascule tout seul sur un fallback mailto (aucune page ne casse).
PUBLIC_FORMSPREE_ENDPOINT=

# URL de production (sert au canonical, aux balises Open Graph, au sitemap et
# au robots.txt). Sans valeur : https://prodbydxt.com
SITE_URL=https://prodbydxt.com
